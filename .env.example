# Dev domyslnie dziala na MSW i nie wymaga credentiali.
# Wypelnij tylko wtedy, gdy uruchamiasz prawdziwe API przez ?mockApi=real.
VITE_TMDB_API_KEY=
# Alternatywnie zamiast VITE_TMDB_API_KEY mozesz uzyc tokena v4:
# VITE_TMDB_ACCESS_TOKEN=
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3

# Demo bledu HTTP 401 jest uruchamiane przez MSW parametrem URL:
# http://localhost:5173/?mockApi=401
